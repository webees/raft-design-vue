    "@webees/raft-design-vue": "workspace:*",
    "markdown-it": "15.0.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "21.1.0",
    "vue-tsc": "^3.2.4"
  }
}
