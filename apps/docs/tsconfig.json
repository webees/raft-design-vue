{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@webees/raft-design-vue": ["../../packages/ui/src/index.ts"],
      "@webees/raft-design-vue/styles.css": ["../../packages/ui/src/styles.css"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "rsbuild.config.ts",
    "src/generated/*.json",
    "../../packages/ui/src/auto-imports.d.ts"
  ]
}
