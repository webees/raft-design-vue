{
  "name": "webees-raft-design-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "bun run --filter @webees/docs dev",
    "build": "bun run build:tokens && bun run build:ui && bun run build:docs",
    "build:tokens": "bun run --cwd packages/ui build:tokens",
    "build:ui": "bun run --cwd packages/ui build",
    "build:docs": "bun run --cwd apps/docs build",
    "test": "bun run --cwd packages/ui test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "sync:upstream": "bun run --cwd tooling/upstream sync",
    "fetch:upstream": "bun run --cwd tooling/upstream sync --locked --snapshot",
    "check:upstream": "bun run --cwd tooling/upstream check",
    "check:parity": "bun run --cwd tooling/upstream parity",
    "check:audit": "bun run --cwd tooling/upstream audit --check",
    "check:docs-links": "bun run --cwd tooling/upstream docs-links --check",
    "check:api": "bun run --cwd packages/ui check:api",
    "check:props": "bun run --cwd packages/ui check:props",
    "check:consumer-types": "cd tests/type-consumer && tsc -p tsconfig.json",
    "changeset": "changeset",
    "verify": "bun run check:parity && bun run check:audit && bun run check:docs-links && bun run lint && bun run typecheck && bun run check:api && bun run check:props && bun run test && bun run build && bun run check:consumer-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.3.11",
    "@types/node": "^26.6.6",
    "@types/web-bluetooth": "0.0.22",
    "typescript": "^7.0.2"
  }
}
